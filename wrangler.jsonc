{
  // Cloudflare Worker for spearpointpro.com
  "name": "spearpoint-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
